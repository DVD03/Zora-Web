# ============================================================================
# ZORA SOLUTIONS — ENTERPRISE ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and provide your production credentials
# ============================================================================

# 1. MongoDB Atlas Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@zora-cluster.mongodb.net/zora_solutions?retryWrites=true&w=majority"

# 2. Edge-Compatible JWT Secret (minimum 32 characters for HS256 signing)
JWT_SECRET="replace-with-a-random-32-char-minimum-secret-key"

# 3. Nodemailer SMTP Alert Configuration (for zorasolution.official@gmail.com)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="zorasolution.official@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
NOTIFICATION_EMAIL="zorasolution.official@gmail.com"

# 4. Initial Admin CMS Bootstrap Credentials
ADMIN_INITIAL_EMAIL="zorasolution.official@gmail.com"
ADMIN_INITIAL_PASSWORD="replace-with-strong-admin-password"

# 5. Optional Cloudflare Turnstile Bot Protection Secret Key
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

